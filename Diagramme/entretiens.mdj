									},
									"font": "Arial;13;0",
									"left": 1240,
									"top": 272,
									"width": 380,
									"height": 104,
									"text": "Step 8 : Alternative scenario\nAt least one required field is blank\n8.1 Display an error message\n8.2 Ask the user to correct them\nIn the nominal scenario, all fields are filled in correctly"
								},
								{
									"_type": "UMLNoteView",
									"_id": "DGEN001583=",
									"_parent": {
										"$ref": "AAAAAAGgHhlv11zPeE0="
									},
									"font": "Arial;13;0",
									"left": 1240,
									"top": 392,
									"width": 380,
									"height": 104,
									"text": "Step 9 : Alternative scenario\nAt least one piece of data is invalid\n9.1 Display an error message\n9.2 Ask the user to correct them\nIn the nominal scenario, all data is valid"
								},
								{
									"_type": "UMLNoteView",
									"_id": "DGEN001585=",
									"_parent": {
										"$ref": "AAAAAAGgHhlv11zPeE0="
									},
									"font": "Arial;13;0",
									"left": 1240,
									"top": 512,
									"width": 380,
									"height": 104,
									"text": "Step 11 : Alternative scenario\nUnable to communicate with the database\n11.1 Display an error message\n11.2 The scenario stops\nIn the nominal scenario, communication is correct"
								},
								{
									"_type": "UMLNoteView",
									"_id": "DGEN001587=",
									"_parent": {
										"$ref": "AAAAAAGgHhlv11zPeE0="
									},
									"font": "Arial;13;0",
									"left": 1240,
									"top": 632,
									"width": 380,
									"height": 104,
									"text": "Step 14 : Alternative scenario\nThe information is not different\n14.1 Display an error message\n14.2 The scenario stops\nIn the nominal scenario, the information is different"
								},
								{
									"_type": "UMLNoteView",
									"_id": "DGEN001589=",
									"_parent": {
										"$ref": "AAAAAAGgHhlv11zPeE0="
