									"top": 32,
									"width": 380,
									"height": 104,
									"text": "Step 2 : Alternative scenario\nThe role does not match\n2.1 Display an error message\n2.2 The scenario stops\nIn the nominal scenario, the role matches"
								},
								{
									"_type": "UMLNoteView",
									"_id": "DGEN001381=",
									"_parent": {
										"$ref": "AAAAAAGgGWHSWVTPcE8="
									},
									"font": "Arial;13;0",
									"left": 1240,
									"top": 152,
									"width": 380,
									"height": 104,
									"text": "Step 3 : Alternative scenario\nThe user is not logged in\n3.1 Display an error message\n3.2 The scenario stops\nIn the nominal scenario, the user is logged in"
								},
								{
									"_type": "UMLNoteView",
									"_id": "DGEN001383=",
									"_parent": {
										"$ref": "AAAAAAGgGWHSWVTPcE8="
									},
									"font": "Arial;13;0",
									"left": 1240,
									"top": 272,
									"width": 380,
									"height": 104,
									"text": "Step 8 : Alternative scenario\nAt least one required field is blank\n8.1 Display an error message\n8.2 Ask the user to correct them\nIn the nominal scenario, all fields are filled in correctly"
								},
								{
									"_type": "UMLNoteView",
									"_id": "DGEN001385=",
									"_parent": {
										"$ref": "AAAAAAGgGWHSWVTPcE8="
									},
									"font": "Arial;13;0",
									"left": 1240,
									"top": 392,
									"width": 380,
									"height": 104,
									"text": "Step 9 : Alternative scenario\nAt least one piece of data is invalid\n9.1 Display an error message\n9.2 Ask the user to correct them\nIn the nominal scenario, all data is valid"
								},
								{
									"_type": "UMLNoteView",
									"_id": "DGEN001387=",
									"_parent": {
